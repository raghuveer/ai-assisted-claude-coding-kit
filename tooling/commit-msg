#!/usr/bin/env bash
# commit-msg — trailer validation. A thin caller; the rules live in kit-trailers.sh.
#
# Do NOT symlink this. kit-init.sh generates a copy in .git/hooks with KIT_TOOLING
# resolved to wherever the plugin actually lives on this machine — which differs per
# developer, and which git cannot share (hooks are per-clone). That is why every team
# member runs kit-init.sh after cloning.
#
# The validation itself is deliberately NOT inlined here. The CI gate checks the same
# trailers, and a second copy of these rules would drift from this one — which is exactly
# the bug 0.2.1 fixed, where the hook and the indexer disagreed about what a trailer is.
set -uo pipefail

: "${KIT_TOOLING:=$(dirname "$0")}"
if [ ! -f "$KIT_TOOLING/kit-trailers.sh" ]; then
  # A validation hook that cannot validate must fail loudly. Passing silently would
  # let untrailered commits through while the repo looks protected -- the fail-open
  # case this hook exists to prevent.
  echo "commit-msg: cannot load kit-trailers.sh from $KIT_TOOLING" >&2
  echo "  re-run kit-init.sh in this repository to regenerate the hook." >&2
  exit 1
fi
exec bash "$KIT_TOOLING/kit-trailers.sh" message "$1"
