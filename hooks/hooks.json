{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/tooling/kit-guard.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/tooling/kit-spend.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/tooling/kit-spend.sh" },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/tooling/kit-checkpoint.sh" }
        ]
      }
    ]
  }
}
