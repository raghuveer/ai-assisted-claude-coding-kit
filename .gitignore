
# derived, rebuildable — never commit
.project/index.db*
STATUS.generated.md
.project/packs/

# kit-entry.sh output. All four are derived from the tree and the history: delete them, run
# again, lose nothing. Committing them would put a machine-local snapshot of somebody's working
# copy into every clone, and it would go stale against the tree with nothing detecting it.
.project/entry-facts.tsv
.project/entry-comment-runs.tsv
.project/entry-report.md
.project/entry-candidates.md

# Python bytecode. kit_findings.py is imported by tests and by hand; the cache it leaves
# is a build artefact, and one swept in by `git add -A` turned three CI jobs red because the
# exec-bit gate reads every path under tooling/.
__pycache__/
*.pyc
